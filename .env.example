###
# Proxmox Configuration
# ---------------------
# Address of the Proxmox host
INFRASTRUCTURE_PROXMOX_ADDRESS="192.168.145.128"

# Root password for the Proxmox host
INFRASTRUCTURE_PROXMOX_PASSWORD="password"

# Codename for this infrastructure setup (used in generated files and keys)
INFRASTRUCTURE_CODENAME="pve"

# Scenario name (used to differentiate environments)
INFRASTRUCTURE_SCENARIO="demo_lab"


###
# Local Deployer Configuration (Mandatory for Docker usage)
# ---------------------------------------------------------
# These settings are required if you plan to run the deployer inside a Docker container.
# The container user is always named 'user'. Do not change this unless you modify the container itself.

# Username for the deployer container (must remain 'user' for Docker)
DEPLOYER_CLI_CONFIG_USER="user"

# IP address of the deployer (usually localhost)
DEPLOYER_CLI_CONFIG_IP="127.0.0.1"


###
# Remote Deployer Configuration
# -----------------------------
# Use these settings only if you are connecting to a remote deployer instead of running the deployer in Docker.
# Uncomment and modify the values as needed:
# DEPLOYER_CLI_CONFIG_USER="test"
# DEPLOYER_CLI_CONFIG_PASSWORD="test"
# DEPLOYER_CLI_CONFIG_IP="10.1.20.12"


###
# Default Options
# ---------------
# Set to YES to generate SSH keys for all users
# GENERATE_SSH_KEYS_PASSWORD="YES"

# Set to YES to create a jump user on Proxmox for SSH
# JUMP_ON_PROXMOX="YES"

# Proxmox storage for ISO images
# INFRASTRUCTURE_PROXMOX_DEST_ISO_STORAGE_NAME="local"

# Proxmox storage for VM disks
# INFRASTRUCTURE_PROXMOX_DEST_VM_STORAGE_NAME="local-lvm"

# Default network interface for Proxmox VMs
# INFRASTRUCTURE_PROXMOX_DEFAULT_NETWORK_CARD_INTERFACE="enp3s0"

# API user for Proxmox
# INFRASTRUCTURE_PROXMOX_API_USER="api_user"


###
# SSH Key Passphrases
# ------------------
# Leave empty to avoid passphrase prompts
PX_ROOT_PASSPHRASE=""
PX_JUMP_PASSPHRASE=""
DEPLOYER_PASSPHRASE=""
STUDENT_PASSPHRASE=""


###
# Existing Proxmox API Credentials (optional)
# ------------------------------------------
# Use these if you already have a token instead of creating a new one
# INFRASTRUCTURE_PROXMOX_API_TOKEN_ID="WI6c"
# INFRASTRUCTURE_PROXMOX_API_TOKEN_SECRET="bc849278-ef09-4188-bab3-046a95aabc4c"
server {
    listen {{ apt_mirror_http_port }};
    listen [::]:{{ apt_mirror_http_port }};

    server_name _;

    # Root maps directly to the mirrored upstream paths.
    # apt-mirror stores content as: <mirror_root>/mirror/<upstream-host>/<path>
    # so http://this-host/deb.debian.org/debian/... resolves correctly.
    root {{ apt_mirror_root }}/mirror;

    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    access_log /var/log/nginx/apt-mirror-access.log;
    error_log  /var/log/nginx/apt-mirror-error.log;

    # Serve mirrored packages
    location / {
        try_files $uri $uri/ =404;
    }

    # Health-check endpoint
    location /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}

server {
    listen {{ apt_mirror_http_port }};
    listen [::]:{{ apt_mirror_http_port }};

    server_name _;

    # Root maps directly to the mirrored upstream paths.
    # apt-mirror stores content preserving the upstream hostname directory structure:
    #   <apt_mirror_root>/mirror/<upstream-host>/<path>
    # e.g. /var/spool/apt-mirror/mirror/deb.debian.org/debian/pool/main/...
    #
    # Clients request:  http://this-host/deb.debian.org/debian/pool/main/...
    # nginx resolves:   <root>/deb.debian.org/debian/pool/main/...
    #
    # DO NOT flatten root to {{ apt_mirror_root }}/mirror/deb.debian.org — that
    # would break multi-distribution mirrors (Debian + Ubuntu share the same root).
    # The /mirror sub-directory is intentional; do not remove it.
    root {{ apt_mirror_root }}/mirror;

    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    access_log /var/log/nginx/apt-mirror-access.log;
    error_log  /var/log/nginx/apt-mirror-error.log;

    # Serve mirrored packages
    location / {
        try_files $uri $uri/ =404;
    }

    # Health-check endpoint
    location /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}

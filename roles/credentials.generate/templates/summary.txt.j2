==============================================================================
 1 - SSH KEY PATHS
==============================================================================

  jump keys (proxmox access):
    root     : {{ credentials_output_dir }}/ssh_keys/jump_keys/px.{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}-ssh_cli.root
    root.pub : {{ credentials_output_dir }}/ssh_keys/jump_keys/px.{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}-ssh_cli.root.pub
    jump     : {{ credentials_output_dir }}/ssh_keys/jump_keys/px.{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}-ssh_cli.jump_user
    jump.pub : {{ credentials_output_dir }}/ssh_keys/jump_keys/px.{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}-ssh_cli.jump_user.pub

  backend keys (admin vms):
    alice     : {{ credentials_output_dir }}/ssh_keys/backend_keys/r42.{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}-deployer-key_alice
    alice.pub : {{ credentials_output_dir }}/ssh_keys/backend_keys/r42.{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}-deployer-key_alice.pub

  student keys:
    bob       : {{ credentials_output_dir }}/ssh_keys/student_keys/r42.{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}-student-key_bob
    bob.pub   : {{ credentials_output_dir }}/ssh_keys/student_keys/r42.{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}-student-key_bob.pub
{% if student_additional_keys_count | default(0) | int > 0 %}

  additional student keys ({{ student_additional_keys_count }}):
{% for i in range(1, student_additional_keys_count + 1) %}
    bob_{{ i }}     : {{ credentials_output_dir }}/ssh_keys/student_keys/additional.students/r42.{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}-student-key_bob_{{ i }}
{% endfor %}
{% endif %}


==============================================================================
 2 - SSH KEY PASSPHRASES
==============================================================================

  Moved to the ansible vault. View with :
    `range42-context show-vault`  (on the deployer-cli)
    OR `ansible-vault view {{ vault_output_dir | default(credentials_output_dir ~ "/secrets") }}/default_vault.yml --vault-password-file ...`

    px root    : <moved to vault — field ssh_passphrase_px_root>
    px jump    : <moved to vault — field ssh_passphrase_px_jump>
    alice      : <moved to vault — field ssh_passphrase_deployer_admin>
    bob        : <moved to vault — field ssh_passphrase_student_user>


==============================================================================
 3 - VM USER PASSWORDS
==============================================================================

  Moved to the ansible vault. View with `range42-context show-vault`.

    alice (admin)   : <moved to vault — field default_admin_vm_ci_password>
    bob (student)   : <moved to vault — field default_trainee_vm_ci_password>
    wazuh (admin)   : <moved to vault — field infrastructure_wazuh_admin_password>


==============================================================================
 4 - WORKSPACE PATHS (after deployer-cli deployment)
==============================================================================

  on deployer-cli:
    workspace        : ~/range42.config/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/
    inventory        : ~/range42.config/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/inventory/inventory_default.yml
    secrets          : ~/range42.config/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/secrets/
    vault file       : ~/range42.config/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/secrets/default_vault.yml
    vault password   : ~/range42.config/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/secrets/vault_pass.txt
    env source       : ~/range42.config/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/sourced_range42.sh
    context tools    : ~/range42.config/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/bin/

  ssh config:
    ssh config file  : ~/.ssh/config_range42-{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}
    ssh keys dir     : ~/.ssh/range42/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/
      backend_keys/  : ~/.ssh/range42/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/backend_keys/
      jump_keys/     : ~/.ssh/range42/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/jump_keys/
      student_keys/  : ~/.ssh/range42/{{ INFRASTRUCTURE_CODENAME }}-{{ INFRASTRUCTURE_SCENARIO }}/student_keys/

  git repos:
    root             : ~/range42/


==============================================================================
 5 - SSH HOSTS (after ssh-config deployment)
==============================================================================

  proxmox:
    web interface    : px.{{ INFRASTRUCTURE_CODENAME }}.redirect_www.proxmox
    root ssh         : px.{{ INFRASTRUCTURE_CODENAME }}-ssh_cli.root
    jump host        : px.{{ INFRASTRUCTURE_CODENAME }}.jumper

  admin vms (user: alice, via jump):
    wazuh            : r42.admin-wazuh
    api gateway      : r42.admin-deployer-api-gateway
    api backend      : r42.admin-deployer-api-backend
    deployer-ui      : r42.admin-deployer-ui

  student vms (user: alice, via jump):
    student box 01   : r42.student-box-01

  vuln vms (user: alice, via jump):
    vuln box 00-04   : r42.vuln-box-{00..04}

# range42 — global ansible settings
# deployed by deployer.bootstrap to ~/.ansible.cfg
# suppresses noisy warnings across all range42 tools

[defaults]
deprecation_warnings = False
command_warnings = False
# silently = allow dots/hyphens in host names (r42.admin-wazuh etc.) without warning every run
force_valid_group_names = silently
host_key_checking = False
timeout = 30

[privilege_escalation]
become = false

[ssh_connection]
pipelining = True
# ssh_args replaces Ansible's default (first 3 options); ServerAlive* fails a silently dead peer (guest reboot) after 30 s x 4 instead of hanging
ssh_args = -C -o ControlMaster=auto -o ControlPersist=60s -o ServerAliveInterval=30 -o ServerAliveCountMax=4
